{
  "name": "@hr-kit/recruiting",
  "version": "0.1.0",
  "description": "MCP server for HR recruiting: resume parsing, candidate scoring, JD generation, bias detection",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --project tsconfig.json --watch",
