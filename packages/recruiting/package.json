    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.1",
    "typescript": "^5.4.5"
  },
  "files": ["dist"],
  "engines": {
    "node": ">=20.0.0"
  }
}
